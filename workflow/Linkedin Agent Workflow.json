    {
      "parameters": {
        "jsCode": "const output = [];\nconst seen = new Set();\n\nfor (const item of items) {\n\n  const xml = item.json.data || \"\";\n\n  const titles = [\n    ...xml.matchAll(/<title><!\\[CDATA\\[(.*?)\\]\\]><\\/title>/gs)\n  ];\n\n  const desc = [\n    ...xml.matchAll(/<description><!\\[CDATA\\[(.*?)\\]\\]><\\/description>/gs)\n  ];\n\n  const links = [\n    ...xml.matchAll(/<link>(.*?)<\\/link>/gs)\n  ];\n\n  // Skip feed title → start at 1\n  for (\n    let i = 1;\n    i < titles.length && output.length < 3;\n    i++\n  ) {\n\n    const title =\n      (titles[i]?.[1] || \"\").trim();\n\n    const summary =\n      (desc[i]?.[1] || \"\")\n        .replace(/<[^>]*>/g, \"\")\n        .replace(/\\s+/g, \" \")\n        .trim()\n        .slice(0, 250);\n\n    const source =\n      (links[i]?.[1] || \"\").trim();\n\n    // Remove duplicates\n    const key = title.toLowerCase();\n\n    if (!title || seen.has(key))\n      continue;\n\n    seen.add(key);\n\n    output.push({\n      json: {\n        title,\n        summary,\n        source\n      }\n    });\n\n  }\n\n  // Stop after collecting 3\n  if (output.length >= 3)\n    break;\n}\n\nreturn output;"
      },
      "id": "dbbc0f47-7ed6-4b16-88e1-ba8b92ff6083",
