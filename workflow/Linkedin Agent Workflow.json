        "jsCode": "const output=[];\n\nconst original=$('Build Preview').all();\n\nfor(let i=0;i<items.length;i++){\n\nconst raw=\nitems[i].json.text||\"\";\n\ntry{\n\nconst parsed=JSON.parse(\nraw\n.replace(/```json/g,\"\")\n.replace(/```/g,\"\")\n.trim()\n);\n\nconst source=\noriginal[\nMath.min(\ni,\noriginal.length-1\n)\n]?.json||{};\n\nif(\n!source.title\n) continue;\n\noutput.push({\n\njson:{\n\ntitle:\nsource.title,\n\nhook:\nsource.hook,\n\npost:\nsource.post,\n\ninsights:\nsource.insights,\n\ncta:\nsource.cta,\n\nhashtags:\nsource.hashtags,\n\nfinal_image_prompt:\nparsed.final_image_prompt\n\n}\n\n});\n\n}\n\ncatch{}\n\n}\n\nreturn output;"
