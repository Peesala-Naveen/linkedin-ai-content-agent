      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of items) {\n\nlet raw = item.json.text || \"\";\n\n// remove markdown\nraw = raw\n.replace(/```json/g, \"\")\n.replace(/```/g, \"\")\n.trim();\n\n// FIX trailing commas\nraw = raw\n.replace(/,\\s*]/g, \"]\")\n.replace(/,\\s*}/g, \"}\");\n\ntry {\n\nconst parsed = JSON.parse(raw);\n\noutput.push({\njson: {\n\ntitle:\nparsed.linkedin_title || \"\",\n\nhook:\nparsed.hook || \"\",\n\npost:\nparsed.description || \"\",\n\ninsights:\nArray.isArray(parsed.insights)\n? parsed.insights.join(\"\\n• \")\n: parsed.insights || \"\",\n\ncta:\nparsed.cta || \"\",\n\nhashtags:\nArray.isArray(parsed.hashtags)\n? parsed.hashtags.join(\" \")\n: parsed.hashtags || \"\",\n\nimage_prompt:\nparsed.image_prompt || \"\"\n\n}\n});\n\n} catch (e) {\n\noutput.push({\njson:{\nerror:\"Invalid JSON\",\nreason:e.message,\nraw\n}\n});\n\n}\n\n}\n\n// ONLY KEEP FIRST VALID POST\nconst valid =\noutput.filter(i => !i.json.error);\n\nreturn valid.length\n? [valid[0]]\n: [{\njson:{\nerror:\"No valid draft\"\n}\n}];"
      },
