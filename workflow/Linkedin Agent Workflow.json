      "parameters": {
        "jsCode": "const raw = items[0].json.text || \"\";\n\ntry {\n\nconst parsed = JSON.parse(\nraw\n.replace(/```json/g,\"\")\n.replace(/```/g,\"\")\n.trim()\n);\n\nconst seen = new Set();\n\nreturn parsed\n.filter(x=>{\nconst key=(x.title||\"\").toLowerCase();\nif(seen.has(key)) return false;\nseen.add(key);\nreturn true;\n})\n.map(x=>({\njson:x\n}));\n\n}\ncatch(e){\n\nreturn [{\njson:{\nerror:true,\nmessage:e.message\n}\n}];\n\n}"
      },
