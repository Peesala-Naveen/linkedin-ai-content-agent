    {
      "parameters": {
        "jsCode": "const clean = (value, fallback = \"\") => {\nif (\nvalue === undefined ||\nvalue === null ||\nvalue === \"\" ||\nvalue === \"undefined\" ||\nvalue === \"null\"\n) {\nreturn fallback;\n}\n\nreturn String(value).trim();\n};\n\nconst output = [];\n\nfor (const item of items) {\n\nconst title = clean(item.json.title);\nconst hook = clean(item.json.hook);\nconst post = clean(item.json.post);\nconst insights = clean(item.json.insights);\nconst cta = clean(item.json.cta);\nconst hashtags = clean(item.json.hashtags);\n\nconst image_prompt =\nclean(\nitem.json.final_image_prompt ||\nitem.json.image_prompt\n);\n\n// Skip completely invalid content\nif (\n!title &&\n!hook &&\n!post &&\n!insights &&\n!cta &&\n!hashtags\n) {\ncontinue;\n}\n\noutput.push({\njson: {\n\ntitle,\n\nhook,\n\npost,\n\ninsights,\n\ncta,\n\nhashtags,\n\nimage_prompt,\n\nimage_status: \"READY\",\n\napproval_status: \"Pending\",\n\nready: true\n\n}\n});\n\n}\n\n// Return one valid item only\nreturn output.length\n? [output[0]]\n: [{\njson:{\nready:false,\nerror:\"No valid content generated\"\n}\n}];"
      },
